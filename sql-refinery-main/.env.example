# Nebius Token Factory — https://docs.tokenfactory.nebius.com/api-reference/introduction
NEBIUS_API_KEY=

# OpenAI-compatible base URL (trailing slash is OK)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nemotron model ID from the Token Factory catalog, e.g.:
# nvidia/Nemotron-3_5-Lightning
# nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# DuckDB database path (:memory: for ephemeral demo data)
DUCKDB_PATH=:memory:

# Optional tuning
SQL_STATEMENT_TIMEOUT_MS=5000
BENCHMARK_WARMUP_RUNS=1
BENCHMARK_TIMED_RUNS=3
